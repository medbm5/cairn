  "components": {
    "schemas": {
      "AssetClass": {
        "type": "string",
        "enum": [
          "global_equity",
          "emerging_equity",
          "euro_gov_bonds",
          "money_market"
        ],
        "title": "AssetClass"
      },
      "BalanceOut": {
        "properties": {
          "goal_id": {
            "type": "integer",
            "title": "Goal Id"
          },
          "total_cents": {
            "type": "integer",
            "title": "Total Cents"
          },
          "contributed_cents": {
            "type": "integer",
            "title": "Contributed Cents"
          },
          "fees_cents": {
            "type": "integer",
            "title": "Fees Cents"
          },
          "holdings": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/AssetClass"
            },
            "type": "object",
            "title": "Holdings"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/AssetClass"
            },
            "type": "object",
            "title": "Weights"
          }
        },
        "type": "object",
        "required": [
          "goal_id",
          "total_cents",
          "contributed_cents",
          "fees_cents",
          "holdings",
          "weights"
        ],
        "title": "BalanceOut"
      },
      "DepositCreate": {
        "properties": {
          "amount_cents": {
            "type": "integer",
            "maximum": 10000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents"
          }
        },
        "type": "object",
        "required": [
          "amount_cents"
        ],
        "title": "DepositCreate"
      },
      "ExplainRequest": {
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/Topic"
          },
          "facts": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Facts"
          },
          "term": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Term"
          },
          "level": {
            "type": "string",
            "enum": [
              "simple",
              "more_detail"
            ],
            "title": "Level",
            "default": "simple"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "ExplainRequest"
      },
      "Explanation": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "analogy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analogy"
          },
          "terms_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Terms Used"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai",
              "fallback"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body",
          "analogy",
          "terms_used",
          "source"
        ],
        "title": "Explanation"
      },
      "GlidePathPoint": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "months_remaining": {
            "type": "integer",
            "title": "Months Remaining"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/AssetClass"
            },
            "type": "object",
            "title": "Weights"
          },
          "equity_share": {
            "type": "number",
            "title": "Equity Share"
          }
        },
        "type": "object",
        "required": [
          "year",
          "months_remaining",
          "weights",
          "equity_share"
        ],
        "title": "GlidePathPoint"
      },
      "GlidePathResponse": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/RiskProfile"
          },
          "horizon_months": {
            "type": "integer",
            "title": "Horizon Months"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/GlidePathPoint"
